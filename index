<!doctype html><html lang="ko"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>MYWAY | SOPT 피치덱</title><style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;background:#111;color:white;font-family:Arial,sans-serif;overflow:hidden}main{height:100%;display:grid;place-items:center;padding-bottom:48px}#stage{width:min(100vw,calc((100dvh - 48px)*16/9));aspect-ratio:16/9;position:relative;background:#000}.slide{position:absolute;inset:0;display:none}.slide.active{display:block}.slide img{width:100%;height:100%;object-fit:contain;display:block}video{position:absolute;left:36.09%;top:4.91%;width:27.82%;height:90.09%;object-fit:contain;background:#fff;border-radius:5.5% / 3.2%}#play{position:absolute;left:38%;top:47%;width:25%;padding:12px 4px;background:#ff2b9b;color:#fff;border:0;border-radius:8px;cursor:pointer}nav{position:fixed;bottom:0;left:0;width:100%;height:48px;display:flex;align-items:center;justify-content:center;gap:12px;background:#111}button{font:inherit;color:inherit;background:#272727;border:1px solid #555;border-radius:6px;padding:6px 13px;cursor:pointer}button:disabled{opacity:.3;cursor:default}button:focus-visible{outline:2px solid #ff2b9b}#count{font-size:14px;min-width:60px;text-align:center}#hint{font-size:12px;color:#aaa;position:absolute;left:14px}#full{position:absolute;right:14px}@media(max-width:650px){#hint{display:none}nav{gap:6px}button{padding:6px 10px}}:fullscreen main{padding-bottom:48px}@media print{body,html{height:auto;overflow:visible;background:white}main{display:block;padding:0;height:auto}#stage{width:100%;aspect-ratio:auto}.slide,.slide.active{position:relative;display:block;aspect-ratio:16/9;break-after:page}nav{display:none}}
</style><main><div id="stage"><section class="slide" aria-label="1번 슬라이드"><img alt="마이웨이 발표자료 1장" src="data:image/png;base64,"></section><section class="slide" aria-label="2번 슬라이드"><img alt="마이웨이 발표자료 2장" src="data:image/png;base64,"></section><section class="slide" aria-label="3번 슬라이드"><img alt="마이웨이 발표자료 3장" src="data:image/png;base64,"></section><section class="slide" aria-label="4번 슬라이드"><img alt="마이웨이 발표자료 4장" src="data:image/png;base64,"></section><section class="slide" aria-label="5번 슬라이드"><img alt="마이웨이 발표자료 5장" src="data:image/png;base64,"></section><section class="slide" aria-label="6번 슬라이드"><img alt="마이웨이 발표자료 6장" src="data:image/png;base64,"><video id="demo" src="data:video/mp4;base64," controls playsinline preload="metadata" aria-label="마이웨이 시연 영상"></video><button id="play" hidden>▶ 영상 재생 (소리 켜짐)</button></section><section class="slide" aria-label="7번 슬라이드"><img alt="마이웨이 발표자료 7장" src="data:image/png;base64,"></section><section class="slide" aria-label="8번 슬라이드"><img alt="마이웨이 발표자료 8장" src="data:image/png;base64,"></section><section class="slide" aria-label="9번 슬라이드"><img alt="마이웨이 발표자료 9장" src="data:image/png;base64,"></section><section class="slide" aria-label="10번 슬라이드"><img alt="마이웨이 발표자료 10장" src="data:image/png;base64,"></section><section class="slide" aria-label="11번 슬라이드"><img alt="마이웨이 발표자료 11장" src="data:image/png;base64,"></section><section class="slide" aria-label="12번 슬라이드"><img alt="마이웨이 발표자료 12장" src="data:image/png;base64,"></section></div></main><nav aria-label="발표 조작"><span id="hint">← → 이동 · F 전체화면 · Space 영상 재생/일시정지</span><button id="prev" aria-label="이전 장">←</button><span id="count" aria-live="polite"></span><button id="next" aria-label="다음 장">→</button><button id="full">전체화면</button></nav><script>
const slides=[...document.querySelectorAll('.slide')], video=document.querySelector('video'), play=document.querySelector('#play');let current=0;
function show(n){n=Math.max(0,Math.min(slides.length-1,n));if(current===5&&n!==5)video.pause();current=n;slides.forEach((s,i)=>{s.classList.toggle('active',i===n);s.setAttribute('aria-hidden',i!==n)});document.querySelector('#count').textContent=`${n+1} / 12`;document.querySelector('#prev').disabled=n===0;document.querySelector('#next').disabled=n===slides.length-1;history.replaceState(null,'','#'+(n+1));if(n===5){video.muted=false;video.play().then(()=>play.hidden=true).catch(()=>play.hidden=false)}}
document.querySelector('#prev').onclick=()=>show(current-1);document.querySelector('#next').onclick=()=>show(current+1);play.onclick=()=>{video.muted=false;video.play().then(()=>play.hidden=true).catch(()=>play.hidden=false)};video.addEventListener('play',()=>play.hidden=true);
function full(){if(document.fullscreenElement)document.exitFullscreen();else document.documentElement.requestFullscreen().catch(()=>{})}document.querySelector('#full').onclick=full;
addEventListener('keydown',e=>{if(e.altKey||e.ctrlKey||e.metaKey)return;if(['ArrowRight','ArrowDown','PageDown'].includes(e.key)){e.preventDefault();show(current+1)}else if(['ArrowLeft','ArrowUp','PageUp'].includes(e.key)){e.preventDefault();show(current-1)}else if(e.key==='Home'){e.preventDefault();show(0)}else if(e.key==='End'){e.preventDefault();show(slides.length-1)}else if(e.key.toLowerCase()==='f'){e.preventDefault();full()}else if(e.code==='Space'){e.preventDefault();if(current===5){if(video.paused)video.play().catch(()=>play.hidden=false);else video.pause()}else show(current+1)}});
document.querySelector('#stage').onclick=e=>{if(e.target.closest('video,button'))return;const r=e.currentTarget.getBoundingClientRect();show(current+(e.clientX-r.left<r.width*.25?-1:1))};let startX;document.querySelector('#stage').addEventListener('touchstart',e=>startX=e.changedTouches[0].clientX,{passive:true});document.querySelector('#stage').addEventListener('touchend',e=>{if(e.target.closest('video,button'))return;const dx=e.changedTouches[0].clientX-startX;if(Math.abs(dx)>60)show(current+(dx<0?1:-1))},{passive:true});
show((parseInt(location.hash.slice(1))||1)-1);
</script></html>